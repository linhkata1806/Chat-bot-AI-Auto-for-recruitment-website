    {
      "id": "catalog-aggregate-verified-jobs",
      "name": "Aggregate Verified Jobs",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "parameters": {
        "aggregate": "aggregateAllItemData",
