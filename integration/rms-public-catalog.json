{
  "id": "RmsCatalogRead01",
  "name": "RMS Public Catalog - Read Only",
  "active": false,
  "nodes": [
    {
      "id": "catalog-catalog-subworkflow-input",
      "name": "Catalog Subworkflow Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "parameters": {
        "inputSource": "passthrough"
      },
      "position": [
        -1500,
        0
      ]
    },
    {
      "id": "catalog-rms-origin-configuration",
      "name": "RMS Origin Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "rmsInternalBase",
              "name": "rmsInternalBase",
              "type": "string",
              "value": "http://host.docker.internal:8080"
            },
            {
              "id": "rmsPublicBase",
              "name": "rmsPublicBase",
              "type": "string",
              "value": "http://localhost:8080"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {
          "includeBinary": false
        }
      },
      "position": [
        -1280,
        0
      ],
      "notesInFlow": true,
      "notes": "Operator configuration only. For native local n8n use http://localhost:8080 internally. Change both origins to the verified RMS port (for example 8082) when needed. Do not map these fields from chat input. No cookies or credentials are used."
    },
    {
      "id": "catalog-read-active-public-board",
      "name": "Read Active Public Board",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "parameters": {
        "method": "GET",
        "url": "={{ $('RMS Origin Configuration').first().json.rmsInternalBase + '/jobs?size=100&sort=jobPostingId,asc' }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "text/html"
            }
          ]
        },
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false,
              "maxRedirects": 0
            }
          },
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "data",
              "fullResponse": false,
              "neverError": false
            }
          },
          "sendCredentialsOnCrossOriginRedirect": false,
          "timeout": 15000,
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "page",
                    "value": "={{ $pageCount }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !/<a\\b[^>]*\\baria-label\\s*=\\s*[\"']Trang sau[\"'][^>]*>/i.test(String($response.body || \"\")) }}",
              "limitPagesFetched": true,
              "maxRequests": 5,
              "requestInterval": 100
            }
          }
        }
      },
      "position": [
        -1060,
        0
      ],
      "notes": "Fixed anonymous GET to the existing public board. Native HTTP pagination changes only page=0..4; no next-page URL is followed. Stop when the source-verified next-page anchor is absent. HTTP, connection and redirect failures stop this subworkflow for the caller to handle."
    },
    {
      "id": "catalog-extract-public-board-fields",
      "name": "Extract Public Board Fields",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "json",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "jobPaths",
              "cssSelector": ".jb-grid .job-card-link",
              "returnValue": "attribute",
              "attribute": "href",
              "returnArray": true
            },
            {
              "key": "total",
              "cssSelector": ".jb-results__count strong",
              "returnValue": "text",
              "returnArray": false
            },
            {
              "key": "nextPage",
              "cssSelector": ".pagination-controls a[aria-label=\"Trang sau\"]",
              "returnValue": "attribute",
              "attribute": "href",
              "returnArray": false
            }
          ]
        },
        "options": {
          "trimValues": true,
          "cleanUpText": true
        }
      },
      "position": [
        -840,
        0
      ]
    },
    {
      "id": "catalog-aggregate-board-pages",
