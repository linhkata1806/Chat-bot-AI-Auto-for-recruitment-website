      "typeVersion": 1,
      "parameters": {
        "aggregate": "aggregateIndividualFields",
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "fieldToAggregate": "jobPaths",
              "renameField": false
            },
            {
              "fieldToAggregate": "total",
              "renameField": false
            },
            {
              "fieldToAggregate": "nextPage",
              "renameField": false
            }
          ]
        },
        "options": {
          "mergeLists": true,
          "keepMissing": true
        }
      },
      "position": [
        -620,
        0
      ]
    },
    {
      "id": "catalog-board-coverage-summary",
      "name": "Board Coverage Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "jobPaths",
              "name": "jobPaths",
              "type": "array",
              "value": "={{ $json.jobPaths || [] }}"
            },
            {
              "id": "boardTotal",
              "name": "boardTotal",
              "type": "number",
              "value": "={{ /^[0-9]+$/.test(String($json.total[0] ?? \"\")) ? Number($json.total[0]) : -1 }}"
            },
            {
              "id": "pagesFetched",
              "name": "pagesFetched",
              "type": "number",
              "value": "={{ $json.total.length }}"
            },
            {
              "id": "pageLimitReached",
              "name": "pageLimitReached",
              "type": "boolean",
              "value": "={{ $json.total.length >= 5 && Boolean($json.nextPage[$json.nextPage.length - 1]) }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {
          "includeBinary": false
        }
      },
      "position": [
        -400,
        0
      ]
