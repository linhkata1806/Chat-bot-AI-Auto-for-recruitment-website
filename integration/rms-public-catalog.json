        "assignments": {
          "assignments": [
            {
              "id": "id",
              "name": "id",
              "type": "number",
              "value": "={{ Number($('Limit Catalog Detail Requests').item.json.jobPath.split('/')[2]) }}"
            },
            {
              "id": "path",
              "name": "path",
              "type": "string",
              "value": "={{ $('Limit Catalog Detail Requests').item.json.jobPath }}"
            },
            {
              "id": "title",
              "name": "title",
              "type": "string",
              "value": "={{ $json.title || \"\" }}"
            },
            {
              "id": "department",
              "name": "department",
              "type": "string",
              "value": "={{ $json.department || \"\" }}"
            },
            {
              "id": "employmentType",
              "name": "employmentType",
              "type": "string",
              "value": "={{ $json.employmentType || \"\" }}"
            },
            {
              "id": "location",
              "name": "location",
              "type": "string",
              "value": "={{ $json.location || \"\" }}"
            },
            {
              "id": "description",
              "name": "description",
              "type": "string",
              "value": "={{ String($json.sections[0] || \"\").slice(0, 2000) }}"
            },
            {
              "id": "requirements",
              "name": "requirements",
              "type": "string",
              "value": "={{ String($json.sections[1] || \"\").slice(0, 2000) }}"
            },
            {
              "id": "benefits",
              "name": "benefits",
              "type": "string",
              "value": "={{ String($json.sections[2] || \"\").slice(0, 1000) }}"
            },
            {
              "id": "url",
              "name": "url",
              "type": "string",
              "value": "={{ $('RMS Origin Configuration').first().json.rmsPublicBase + $('Limit Catalog Detail Requests').item.json.jobPath }}"
            },
            {
              "id": "textTruncated",
              "name": "textTruncated",
              "type": "boolean",
              "value": "={{ String($json.sections[0] || \"\").length > 2000 || String($json.sections[1] || \"\").length > 2000 || String($json.sections[2] || \"\").length > 1000 }}"
            },
            {
              "id": "acceptingApplications",
              "name": "acceptingApplications",
              "type": "boolean",
              "value": "={{ Boolean($json.acceptingBadge) && !$json.closedBadge && Boolean($json.title) && Boolean($json.sections[0]) && Boolean($json.sections[1]) }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {
          "includeBinary": false
        }
      },
