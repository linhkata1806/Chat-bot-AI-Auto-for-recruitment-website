    {
      "id": "catalog-return-verified-public-catalog",
      "name": "Return Verified Public Catalog",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "status",
              "name": "status",
              "type": "string",
              "value": "ok"
            },
            {
              "id": "jobs",
              "name": "jobs",
              "type": "array",
              "value": "={{ ($json.jobs || []).filter(job => job.acceptingApplications === true && /^\\/jobs\\/[1-9][0-9]*$/.test(job.path || \"\")) }}"
            },
            {
              "id": "boardTotal",
              "name": "boardTotal",
              "type": "number",
              "value": "={{ $('Board Coverage Summary').first().json.boardTotal }}"
            },
            {
              "id": "fetchedCount",
              "name": "fetchedCount",
              "type": "number",
              "value": "={{ ($json.jobs || []).filter(job => job.acceptingApplications === true).length }}"
            },
            {
              "id": "pagesFetched",
              "name": "pagesFetched",
              "type": "number",
              "value": "={{ $('Board Coverage Summary').first().json.pagesFetched }}"
            },
            {
              "id": "partial",
              "name": "partial",
              "type": "boolean",
              "value": "={{ $('Board Coverage Summary').first().json.pageLimitReached || $json.jobs.filter(job => job.acceptingApplications === true).length !== $('Board Coverage Summary').first().json.boardTotal }}"
            },
            {
              "id": "coverageWarning",
              "name": "coverageWarning",
              "type": "string",
              "value": "={{ $('Unique Public Job Paths').all().length > 20 ? 'Only the first 20 public jobs by posting ID were checked. Recommendations cover that subset; other suitable jobs may exist. Some job text is limited in length; use the detail links for complete requirements.' : ($('Board Coverage Summary').first().json.pageLimitReached || $json.jobs.filter(job => job.acceptingApplications === true).length !== $('Board Coverage Summary').first().json.boardTotal ? 'The board reported ' + $('Board Coverage Summary').first().json.boardTotal + ' active jobs, but only ' + $json.jobs.filter(job => job.acceptingApplications === true).length + ' jobs were verified as accepting applications. Results may cover a subset because of pagination limits, rejected links, incomplete details, or changed availability. Some job text is limited in length; use the detail links for complete requirements.' : '') }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {
          "includeBinary": false
        }
      },
      "position": [
        2460,
        -240
      ]
    },
